{
  "name": "nocsc-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run build && node scripts/check-site.mjs",
    "check:links": "node scripts/check-external.mjs"
  },
  "dependencies": { "astro": "5.17.3" },
  "devDependencies": { "parse5": "7.3.0" }
}
