---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import { url } from '../../lib/site';
export async function getStaticPaths() { return (await getCollection('campaigns',({data})=>data.published)).map(campaign=>({params:{slug:campaign.id},props:{campaign}})); }
const { campaign } = Astro.props;
const { data } = campaign;
const { Content } = await render(campaign);
---
<BaseLayout title={data.title} description={data.description}>
  <section class="page-hero hero" data-enter><div class="wrap"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={url('/')}>Home</a><span aria-hidden="true">/</span><a href={url('/campaigns/')}>Campaigns</a></nav><h1>{data.title}</h1><p class="lead">{data.description}</p><p class="campaign-period">{data.period} · {data.status==='past'?'Past campaign':'Current campaign'}</p></div></section>
  <article class="wrap campaign-detail">{data.image && <figure class="campaign-detail-image"><img src={url(data.image)} alt={data.imageAlt || ''} width="1398" height="1046" /></figure>}<div class="prose"><Content /></div>{data.sources.length>0 && <section class="sources"><h2>Sources & further reading</h2><ul>{data.sources.map(s=><li><a href={url(s.url)}>{s.label}</a></li>)}</ul></section>}{data.updated && <p class="updated">Campaign update: <time datetime={data.updated}>{new Date(`${data.updated}T12:00:00Z`).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'})}</time></p>}</article>
  <section class="page-close"><div class="wrap"><h2>Be part of the next step.</h2><a class="btn" href={url('/get-involved/')}>Get involved <Arrow /></a></div></section>
</BaseLayout>
