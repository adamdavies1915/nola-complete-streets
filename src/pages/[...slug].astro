---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import Meeting from '../components/Meeting.astro';
import CampaignList from '../components/CampaignList.astro';
import PhotoChapters from '../components/PhotoChapters.astro';
import ResourceList from '../components/ResourceList.astro';
import { settings, url } from '../lib/site';
export async function getStaticPaths() { return (await getCollection('pages', ({data})=>data.published)).map(page=>({params:{slug:page.id},props:{page}})); }
const { page } = Astro.props;
const { Content, headings } = await render(page);
const { data } = page;
const projects = data.view === 'projects' ? (await getCollection('projects',({data})=>data.published)).sort((a,b)=>a.data.order-b.data.order) : [];
const members = data.view === 'members' ? (await getCollection('members',({data})=>data.published)).sort((a,b)=>a.data.order-b.data.order) : [];
const toc = headings.filter(h=>h.depth===2);
---
<BaseLayout title={data.title} description={data.description}>
  <section class="page-hero hero" data-enter aria-labelledby="hero-h"><div class="wrap"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={url('/')}>Home</a>{data.parent !== '/' && <><span aria-hidden="true">/</span><a href={url(data.parent)}>{data.parentLabel}</a></>}</nav><h1 id="hero-h">{data.title}</h1><p class="lead">{data.description}</p></div></section>
  <div class:list={['wrap page-content',{'with-toc': data.view==='article' && toc.length>2}]}>
    {data.view==='article' && toc.length>2 && <aside class="page-toc"><nav aria-label="On this page"><h2>On this page</h2>{toc.map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</nav></aside>}
    <div class="page-body">
      {data.view==='routes' && <section class="map-section" aria-label="New Orleans bike routes"><p>Find low-stress bike routes anywhere in <a class="link" target="_blank" rel="noopener noreferrer" href={settings.bikeMapUrl}>New Orleans</a> on the New Orleans Bike Map.</p><iframe class="bikestreets" src={settings.bikeMapEmbedUrl} width="100%" height="400" loading="lazy" title="Bike Streets: The Low-Stress New Orleans Bike Map - Trails, Lanes, Routes" referrerpolicy="strict-origin-when-cross-origin"></iframe><a class="text-link" href={settings.bikeMapUrl} target="_blank" rel="noopener noreferrer">Open Bike Streets in a new tab <Arrow external /></a><p class="small">Map provided by Bike Streets. If the map does not load, use the link above.</p></section>}
      {data.image && <figure class="article-image"><img src={url(data.image)} alt={data.imageAlt || ''} width="1400" height="950" loading="lazy" /></figure>}
      <div class="prose"><Content /></div>
      {data.links.length>0 && <div class="directory">{data.links.map(item=><article><h2><a href={url(item.href)}>{item.title}<Arrow /></a></h2><p>{item.description}</p></article>)}</div>}
      {['campaigns','current'].includes(data.view) && <><CampaignList />{data.view==='campaigns' && <div class="directory"><article><h2><a href={url('/campaigns/past/')}>Past campaigns<Arrow /></a></h2><p>See what our current work builds on.</p></article><article><h2><a href={url('/campaigns/project-inventory/')}>Project inventory & map<Arrow /></a></h2><p>Follow transportation projects across the city.</p></article></div>}</>}
      {data.view==='past' && <CampaignList status="past" />}
      {data.view==='involved' && <><Meeting /><section class="involvement-email" id="email"><h2>Stay in the conversation.</h2>{settings.newsletterUrl ? <><p>Get coalition updates, meeting notices and ways to take action.</p><a class="btn" href={settings.newsletterUrl}>Join our email list <Arrow external /></a></> : <><p>Email the coalition to ask about updates and ways to participate.</p><a class="btn" href={`mailto:${settings.email}?subject=Keep%20me%20involved`}>Email the coalition <Arrow /></a></>}<p class="small">Planning your trip? <a href={url('/resources/bike-routes/')}>Explore bike routes</a> or <a href="https://www.norta.com/">check RTA service</a>.</p></section></>}
      {data.view==='certification' && <div class="callout"><h2>Start planning your event.</h2><div class="actions">{settings.certificationChecklistUrl && <a class="btn" href={settings.certificationChecklistUrl}>Open the event checklist <Arrow external /></a>}{settings.certificationFlyerUrl && <a class="text-link" href={settings.certificationFlyerUrl}>Download the flyer <Arrow external /></a>}<a class="text-link" href={`mailto:${settings.certificationContactEmail}?subject=Complete%20Streets%20Event%20Partnership`}>Talk with the coalition <Arrow /></a></div></div>}
      {['research','plans'].includes(data.view) && <ResourceList category={data.view==='plans'?'plan':'research'} />}
      {data.view==='projects' && <div class="resource-list">{projects.map(({data:p})=><article class="resource-row"><div><h2><a href={p.url}>{p.title}<Arrow external /></a></h2><p>{p.description}</p><p class="small">{p.location} · {p.status}</p></div><p class="resource-meta">{p.agency}</p></article>)}</div>}
      {data.view==='members' && <>{members.filter(m=>m.data.type==='executive').length>0 && <section class="member-section"><h2>Executive committee members</h2><div class="member-list">{members.filter(m=>m.data.type==='executive').map(({data:m})=><article><h3>{m.name}</h3><p>{m.role}{m.organization && ` · ${m.organization}`}</p></article>)}</div></section>}<section class="member-section"><h2>Member organizations</h2>{members.some(m=>m.data.type==='organization') ? <div class="member-list">{members.filter(m=>m.data.type==='organization').map(({data:m})=><article><h3>{m.url?<a href={m.url}>{m.name}<Arrow external /></a>:m.name}</h3></article>)}</div> : <><p>Our work brings together people focused on transportation, public health, water, housing, neighborhood life and the environment.</p><p>Represent an organization? <a class="link" href={`mailto:${settings.email}?subject=Coalition%20membership`}>Ask about joining the coalition.</a></p></>}</section></>}
      {data.view==='storymap' && <><section class="storymap-section"><h2>Explore the project storymap.</h2>{settings.storymapEmbedEnabled && <iframe src={`${settings.storymapUrl}?header=false`} title="New Orleans transportation project inventory storymap" width="100%" height="650" loading="lazy" allow="fullscreen" referrerpolicy="strict-origin-when-cross-origin"></iframe>}<div class="actions"><a class="btn" href={settings.storymapUrl} target="_blank" rel="noopener noreferrer">Open the project storymap <Arrow external /></a><a class="text-link" href={url('/resources/projects/')}>Browse the project directory <Arrow /></a></div><p class="small">The storymap opens in ArcGIS. If it is unavailable, the project directory links directly to agency information.</p></section><section class="callout"><h2>Keep exploring with Better Streets.</h2><p>Better Streets offers another way to explore local projects and the work connecting our neighborhoods.</p><a class="text-link" href={settings.betterStreetsUrl}>Explore Better Streets <Arrow external /></a></section></>}
      {data.sources.length>0 && <section class="sources"><h2>Sources & further reading</h2><ul>{data.sources.map(source=><li><a href={url(source.url)}>{source.label}</a></li>)}</ul></section>}
      {data.updated && <p class="updated">Last content update: <time datetime={data.updated}>{new Date(`${data.updated}T12:00:00Z`).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'})}</time></p>}
    </div>
  </div>
  {page.id==='complete-streets' && <PhotoChapters />}
  <section class="page-close"><div class="wrap"><h2>Your experience belongs here.</h2><a class="btn" href={data.view==='involved'?`mailto:${settings.email}`:url('/get-involved/')}>{data.view==='involved'?'Contact the coalition':'Get involved'} <Arrow /></a></div></section>
</BaseLayout>
